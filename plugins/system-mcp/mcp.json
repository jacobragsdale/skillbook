{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "system-monitor": {
      "type": "stdio",
      "command": "python3",
      "args": ["-m", "http.server", "8000"],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "DATA_PATH": "${PLUGIN_DATA}/logs"
      }
    }
  }
}
