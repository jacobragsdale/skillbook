{
  "version": 1,
  "source": {
    "id": "skillbook",
    "name": "Skillbook",
    "description": "Jacob's canonical library of portable Agent Skills."
  },
  "installs": [
    {
      "id": "git-ops",
      "source": "skills/git-ops",
      "destination": "~/.agents/skills/skillbook-git-ops"
    },
    {
      "id": "jacob-create-skill",
      "source": "skills/jacob-create-skill",
      "destination": "~/.agents/skills/skillbook-jacob-create-skill"
    },
    {
      "id": "jacob-home-server",
      "source": "skills/jacob-home-server",
      "destination": "~/.agents/skills/skillbook-jacob-home-server"
    },
    {
      "id": "mermaid",
      "source": "skills/mermaid",
      "destination": "~/.agents/skills/skillbook-mermaid"
    },
    {
      "id": "python-standards",
      "source": "skills/python-standards",
      "destination": "~/.agents/skills/skillbook-python-standards"
    },
    {
      "id": "python-testing",
      "source": "skills/python-testing",
      "destination": "~/.agents/skills/skillbook-python-testing"
    },
    {
      "id": "releases",
      "source": "skills/releases",
      "destination": "~/.agents/skills/skillbook-releases"
    },
    {
      "id": "typescript-standards",
      "source": "skills/typescript-standards",
      "destination": "~/.agents/skills/skillbook-typescript-standards"
    },
    {
      "id": "write-diataxis-docs",
      "source": "skills/write-diataxis-docs",
      "destination": "~/.agents/skills/skillbook-write-diataxis-docs"
    },
    {
      "id": "data-engineer",
      "source": "plugins/data-engineer",
      "destination": "~/.agents/plugins/skillbook-data-engineer"
    },
    {
      "id": "devops-toolkit",
      "source": "plugins/devops-toolkit",
      "destination": "~/.agents/plugins/skillbook-devops-toolkit"
    }
  ]
}
