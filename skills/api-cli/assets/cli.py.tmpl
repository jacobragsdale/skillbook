"""Agent-first command line over a generated catalogue of API operations.

Generated by the api-cli skill. The catalogue is ``commands.json`` next to this
file; regenerate both with the skill's ``build.py`` rather than editing them.
Discovery (``search``, group listings, ``--help``) reads only the catalogue;
``httpx`` and ``websockets`` are imported when a command actually calls the API.
"""

from __future__ import annotations

import contextlib
import datetime as dt
import difflib
import json
import math
import os
import re
import sys
import tempfile
import time
import urllib.parse
from collections import Counter
from dataclasses import dataclass, field
from pathlib import Path
from typing import TYPE_CHECKING, NoReturn, NotRequired, TypedDict

if TYPE_CHECKING:
    import httpx

__all__ = ["main"]

type JSON = str | int | float | bool | list[JSON] | dict[str, JSON] | None


class Param(TypedDict):
    name: str
    flag: str
    loc: str  # path | query | header | body | form | ws
    kind: str  # str | int | num | bool | json | file | array
    items: NotRequired[str]
    enum: NotRequired[list[str | int | float | bool]]
    format: NotRequired[str]
    required: NotRequired[bool]
    desc: NotRequired[str]
    sep: NotRequired[str]
    default: NotRequired[str | int | float | bool]


class Message(TypedDict):
    name: str
    desc: NotRequired[str]
    example: NotRequired[JSON]
    shape: NotRequired[str]


class Op(TypedDict):
    api: str
    method: str  # GET | POST | ... | WS
    path: str
    group: str
    action: str
    op_id: str
    summary: str
    params: list[Param]
    ns: NotRequired[str]
    desc: NotRequired[str]
    body_type: NotRequired[str]
    body_required: NotRequired[bool]
    raw_body: NotRequired[bool]
    returns: NotRequired[str]
    fields: NotRequired[list[str]]
    accept: NotRequired[str]
    paged: NotRequired[bool]
    deprecated: NotRequired[bool]
    send: NotRequired[list[Message]]
    recv: NotRequired[list[Message]]


class Auth(TypedDict):
    type: str  # none | bearer | header | query | basic
    name: NotRequired[str]
    template: NotRequired[str]


class Api(TypedDict):
    base: str
    env: str
    auth: Auth
    base_env: NotRequired[str]


class Index(TypedDict):
    name: str
    title: str
    apis: dict[str, Api]
    groups: dict[str, str]
    ops: list[Op]


# The catalogue is generated by build.py and checked by the project's tests.
INDEX: Index = json.loads(Path(__file__).with_name("commands.json").read_text(encoding="utf-8"))
PROG = INDEX["name"]
OPS = INDEX["ops"]
MULTI_NS = len({op.get("ns", "") for op in OPS}) > 1

OPTIONS = {"fields", "paginate", "dry-run", "raw", "input", "output", "yes"}
SWITCHES = {"paginate", "dry-run", "raw", "yes"}
MAX_PAGES = 20
BIG_GROUP = 40
GUARD_CHARS = 12_000
PREFERRED = ("number", "id", "name", "login", "title", "event", "headline", "state", "status", "symbol", "price")
STOP = frozenset(
    {
        "a",
        "an",
        "the",
        "to",
        "for",
        "of",
        "in",
        "on",
        "with",
        "from",
        "by",
        "and",
        "or",
        "is",
        "are",
        "be",
        "this",
        "that",
        "it",
        "i",
        "what",
        "which",
        "how",
        "do",
        "does",
        "can",
        "some",
        "any",
        "into",
        "at",
        "as",
        "am",
        "was",
        "were",
        "there",
    }
)
SYNONYMS = {
    "remove": ["delete"],
    "delete": ["remove"],
    "add": ["create"],
    "new": ["create"],
    "create": ["add", "new"],
    "show": ["get", "list"],
    "view": ["get"],
    "fetch": ["get"],
    "read": ["get"],
    "find": ["search", "list", "get"],
    "search": ["find", "list"],
    "edit": ["update"],
    "update": ["edit", "set"],
    "change": ["update", "edit", "set"],
    "modify": ["update", "edit"],
    "close": ["update", "edit", "state"],
    "reopen": ["update", "edit", "state"],
    "rename": ["update", "edit"],
    "all": ["list"],
    "list": ["all", "get"],
    "my": ["authenticated", "current", "user"],
    "me": ["authenticated", "current", "user"],
    "mine": ["authenticated", "current", "user"],
    "who": ["authenticated", "user"],
    "watch": ["stream", "ws"],
    "stream": ["ws"],
    "live": ["stream", "ws"],
    "listen": ["stream", "ws"],
    "tail": ["stream", "ws"],
    "follow": ["stream", "ws"],
    "realtime": ["stream", "ws"],
}
FIELD_WEIGHTS = {"name": 3.0, "summary": 2.0, "path": 1.0, "desc": 0.6, "params": 0.4}


class UsageError(Exception):
    """A mistake the caller can fix; printed with the way to fix it, exit code 2."""


def fail(message: str) -> NoReturn:
    raise UsageError(message)


def out(text: str) -> None:
    sys.stdout.write(text if text.endswith("\n") else text + "\n")


def err(text: str) -> None:
    sys.stderr.write(text if text.endswith("\n") else text + "\n")


def truthy(value: str | None) -> bool:
    return (value or "").lower() in ("1", "true", "yes")


def parse_json(text: str | bytes) -> JSON:
    """json.loads, typed: the parser only ever produces JSON values."""
    parsed: JSON = json.loads(text)
    return parsed


def dumps(data: object, pretty: bool = False) -> str:
    return json.dumps(data, ensure_ascii=False, indent=2 if pretty else None, separators=None if pretty else (",", ":"))


def command(op: Op) -> str:
    return " ".join(x for x in (PROG, op.get("ns", ""), op["group"], op["action"]) if x)


# ---------- settings ----------


@dataclass(frozen=True)
class Settings:
    """Optional environment overrides; absence means "use the catalogue default"."""

    base_url: str
    token: str | None
    read_only: bool


def settings(api: Api) -> Settings:
    # Stdlib instead of pydantic-settings: every variable is optional and the
    # import would add ~120 ms to each API call (measured when this was built).
    env = api["env"]
    base = os.environ.get(api.get("base_env", f"{env}_BASE_URL")) or api["base"]
    if base and not base.startswith(("http://", "https://", "ws://", "wss://")):
        fail(f"base URL {base!r} must start with http(s):// or ws(s)://; set {api.get('base_env', f'{env}_BASE_URL')}")
    return Settings(base.rstrip("/"), os.environ.get(f"{env}_TOKEN") or None, truthy(os.environ.get(f"{env}_READ_ONLY")))


# ---------- discovery ----------


def overview() -> str:
    groups = Counter((op.get("ns", ""), op["group"]) for op in OPS if not op.get("deprecated"))
    sample = next((op["summary"].lower().rstrip(".").split()[:3] for op in OPS if op["method"] == "GET" and op["action"].startswith("list")), ["list"])
    while len(sample) > 1 and sample[-1] in STOP:
        sample.pop()
    lines = [
        f"{PROG}: {INDEX['title']} — {len(OPS)} commands in {len(groups)} groups. Output: JSON.",
        f'Start here:  {PROG} search <what you want to do>    e.g. {PROG} search "{" ".join(sample)}"',
        f"Browse:      {PROG} <group>    Details: {PROG} <group> <action> --help",
        "Flags:       --fields a,b.c  --paginate  --dry-run  --raw (untrimmed)  --input JSON|@file|-  --output FILE  --yes (for DELETE)",
    ]
    by_env: dict[str, list[Api]] = {}
    for api in INDEX["apis"].values():
        by_env.setdefault(api["env"], []).append(api)
    for env, apis in by_env.items():
        needs_token = any(api["auth"]["type"] != "none" for api in apis)
        auth = f"{env}_TOKEN is {'set' if os.environ.get(env + '_TOKEN') else 'NOT set'}" if needs_token else "none needed"
        bases = " ".join(os.environ.get(api.get("base_env", f"{env}_BASE_URL")) or api["base"] or "(unset)" for api in apis)
        lines.append(f"Auth: {auth} · Base URL: {bases}")
    lines.append(f"Now: {dt.datetime.now(dt.UTC):%Y-%m-%dT%H:%MZ}")
    lines.append("Groups:")
    row = ""
    for (ns, group), count in sorted(groups.items()):
        item = f"{ns + ' ' if MULTI_NS else ''}{group}({count})"
        if len(row) + len(item) > 100:
            lines.append("  " + row.rstrip())
            row = ""
        row += item + "  "
    lines.append("  " + row.rstrip())
    return "\n".join(lines)


def group_listing(ns: str, group: str) -> str:
    members = [op for op in OPS if op["group"] == group and op.get("ns", "") == ns and not op.get("deprecated")]
    desc = INDEX["groups"].get(group, "")
    lines = [f"{PROG} {group}: {desc}" if desc else f"{PROG} {group}"]
    if len(members) > BIG_GROUP:
        row = ""
        for op in members:
            if len(row) + len(op["action"]) > 100:
                lines.append("  " + row.rstrip())
                row = ""
            row += op["action"] + "  "
        lines.append("  " + row.rstrip())
        lines.append(f"({len(members)} commands, names only. Find by intent: {PROG} search <words>. Details: {PROG} {group} <action> --help)")
        return "\n".join(lines)
    width = max((len(op["action"]) for op in members), default=0)
    lines += [f"  {op['action']:<{width}}  {op['summary']}" for op in members]
    lines.append(f"Details: {PROG} {group} <action> --help   Faster: {PROG} search <words>")
    return "\n".join(lines)


def type_label(p: Param) -> str:
    if "enum" in p:
        values = [str(v) for v in p["enum"]]
        return "|".join(values[:12]) + ("|…" if len(values) > 12 else "") + ("[]" if p["kind"] == "array" else "")
    if p["kind"] == "array":
        return p.get("items", "str") + "[]"
    return p.get("format", "str") if p["kind"] == "str" else p["kind"]


def placeholder(p: Param) -> str:
    if "enum" in p:
        return str(p["enum"][0])
    return {"int": "1", "num": "1.0", "bool": "true", "json": "'{}'", "file": "./file"}.get(p["kind"], f"<{p['name']}>")


def example_fields(op: Op) -> list[str]:
    names = op.get("fields", [])
    picked = sorted((n for n in names if n.rsplit(".", 1)[-1] in PREFERRED), key=lambda n: (PREFERRED.index(n.rsplit(".", 1)[-1]), n.count(".")))
    return (picked or names)[:3]


def example(op: Op) -> str:
    parts = [command(op)] + [f"--{p['flag']} {placeholder(p)}" for p in op["params"] if p.get("required")]
    if op["method"] == "WS":
        sends = [m for m in op.get("send", []) if "example" in m]
        if sends:
            parts.append("--send '" + dumps(sends[0]["example"]) + "'")
        return " ".join([*parts, "--count 5 --timeout 10"])
    fields = example_fields(op)
    if fields and op["method"] == "GET":
        parts.append("--fields " + ",".join(fields))
    if op["method"] == "DELETE":
        parts.append("--yes")
    return " ".join(parts)


def op_help(op: Op) -> str:
    lines = [f"{command(op)} — {op['summary']}"]
    if op.get("desc") and len(op.get("desc", "")) > len(op["summary"]) + 10:
        lines.append(op.get("desc", ""))
    lines.append(f"{op['method']} {op['path']}" + ("   (paginated: --paginate fetches all pages)" if op.get("paged") else ""))
    params = op["params"]
    if params:
        width = min(max(len(p["flag"]) + len(type_label(p)) + 4 for p in params), 44)
        for p in sorted(params, key=lambda p: not p.get("required")):
            left = f"--{p['flag']} {type_label(p)}"
            default = f" (default {p['default'] if isinstance(p['default'], str) else dumps(p['default'])})" if "default" in p else ""
            lines.append(f" {'*' if p.get('required') else ' '}{left:<{width}} {p.get('desc', '')}{default}".rstrip())
    if "body_type" in op:
        how = "--input JSON|@file|-" + ("" if op.get("raw_body") else "; field flags override it")
        lines.append(f"Body {op['body_type']}{' (required)' if op.get('body_required') else ''}: {how}")
    for label, key in (("Send (--send, JSON)", "send"), ("Receives", "recv")):
        for m in op.get(key, []):
            body = dumps(m["example"]) if key == "send" and "example" in m else m.get("shape", "")
            lines.append(f"{label}: {m['name']} {body}".rstrip() + (f"  — {m['desc']}" if "desc" in m else ""))
    if op["method"] == "WS":
        lines.append("Streams are live: nothing sent before you connect is replayed. To catch an event you trigger, start the")
        lines.append("listener first (… > events.jsonl &), act, then read the file. One JSON message per line; a summary goes to stderr.")
    elif "returns" in op:
        lines.append(f"Returns: {op['returns']}")
    positional = " ".join(f"<{p['flag']}>" for p in path_slots(op))
    notes = ["* required"] + ([f"path values may be positional: {positional}"] if positional else []) + (["DELETE needs --yes"] if op["method"] == "DELETE" else [])
    lines.append("; ".join(notes) + ". Globals: --fields --paginate --dry-run --raw --output")
    lines.append(f"e.g. {example(op)}")
    return "\n".join(lines)


# ---------- search ----------


def stem(word: str) -> str:
    for suffix, repl in (("ies", "y"), ("sses", "ss"), ("ing", ""), ("ed", ""), ("es", ""), ("s", "")):
        if word.endswith(suffix) and len(word) - len(suffix) >= 3:
            return word[: -len(suffix)] + repl
    return word


def split_words(text: str) -> list[str]:
    text = re.sub(r"([a-z0-9])([A-Z])", r"\1 \2", text)
    return [w.lower() for w in re.split(r"[^A-Za-z0-9]+", text) if w]


def doc_fields(op: Op) -> dict[str, Counter[str]]:
    texts = {
        "name": f"{op['group']} {op['action']} {op.get('ns', '')}",
        "summary": op["summary"],
        "path": " ".join(x for x in op["path"].split("/") if not x.startswith("{")),
        "desc": op.get("desc", "") + (" websocket stream live events feed" if op["method"] == "WS" else ""),
        "params": " ".join(p["name"] for p in op["params"]),
    }
    return {f: Counter(stem(w) for w in split_words(t) if w not in STOP) for f, t in texts.items()}


def rank(query: str) -> list[tuple[float, bool, Op]]:
    """BM25F-style score times squared term coverage: (score, matched every word, op), best first."""
    docs = [(op, doc_fields(op)) for op in OPS]
    n = len(docs)
    avg = {f: sum(sum(d[f].values()) for _, d in docs) / n or 1.0 for f in FIELD_WEIGHTS}
    df: Counter[str] = Counter()
    for _, d in docs:
        df.update(set().union(*d.values()))
    terms = [w for w in split_words(query) if w not in STOP] or split_words(query)
    expansions: list[dict[str, float]] = []
    for word in terms:
        exp: dict[str, float] = {}
        for q, weight in [(stem(word), 1.0)] + [(stem(s), 0.5) for s in SYNONYMS.get(word, [])]:
            for v in df:
                if v == q:
                    exp[v] = max(exp.get(v, 0.0), weight)
                elif (len(q) >= 3 and v.startswith(q)) or (len(v) >= 4 and q.startswith(v)):
                    exp[v] = max(exp.get(v, 0.0), weight * 0.7)
        expansions.append(exp)
    scored: list[tuple[float, bool, Op]] = []
    for op, d in docs:
        total, hits = 0.0, 0
        for exp in expansions:
            best = 0.0
            for v, weight in exp.items():
                tf = sum(FIELD_WEIGHTS[f] * d[f][v] / (0.5 + 0.5 * sum(d[f].values()) / avg[f]) for f in FIELD_WEIGHTS if d[f][v])
                if tf:
                    idf = math.log(1 + (n - df[v] + 0.5) / (df[v] + 0.5))
                    best = max(best, weight * idf * tf / (tf + 1.2))
            if best:
                hits += 1
                total += best
        if total:
            total *= (hits / len(expansions)) ** 2 * (0.5 if op.get("deprecated") else 1.0)
            scored.append((total, hits == len(expansions), op))
    scored.sort(key=lambda x: -x[0])
    return scored


def search_lines(query: str, limit: int) -> list[str]:
    hits = rank(query)
    lines: list[str] = ["(no command matches every word; closest:)"] if hits and not hits[0][1] else []
    for _, _, op in hits[:limit]:
        required = " ".join(f"--{p['flag']}" for p in op["params"] if p.get("required"))
        lines.append(f"{command(op)}  {required}".rstrip() + f"  # {op['summary']}")
    if len(hits) > limit:
        lines.append(f"({limit} of {len(hits)}; --limit N for more. Details: <command> --help)")
    return lines


def search_command(args: list[str]) -> int:
    limit, words = 6, []
    i = 0
    while i < len(args):
        name, eq, value = args[i].partition("=")
        if name == "--limit":
            if not eq:
                i += 1
                value = args[i] if i < len(args) else ""
            if not value.isdigit():
                fail("--limit needs a number")
            limit = int(value)
        else:
            words.append(args[i])
        i += 1
    if not words:
        fail(f'usage: {PROG} search <words>   e.g. {PROG} search "create a comment"')
    lines = search_lines(" ".join(words), limit)
    out("\n".join(lines) if lines else f"no matches for {' '.join(words)!r}; try other words, or browse: {PROG}")
    return 0


# ---------- argument parsing ----------


def norm(text: str) -> str:
    return re.sub(r"[^a-z0-9]", "", text.lower())


def resolve(argv: list[str]) -> tuple[Op, list[str]] | str:
    """The operation and its remaining args, or a listing to print instead."""
    ns = ""
    if MULTI_NS and argv[0] in {op.get("ns", "") for op in OPS}:
        ns, argv = argv[0], argv[1:]
        if not argv or argv[0].startswith("-"):
            return f"{PROG} {ns} groups: " + " ".join(sorted({op["group"] for op in OPS if op.get("ns", "") == ns}))
    head = argv[0]
    members = [op for op in OPS if op.get("ns", "") == ns and op["group"] == head]
    if members:
        if len(argv) == 1 or argv[1].startswith("-"):
            return group_listing(ns, head)
        for op in members:
            if op["action"] == argv[1]:
                return op, argv[2:]
        close = difflib.get_close_matches(argv[1], [op["action"] for op in members], n=5, cutoff=0.5)
        hint = f" Did you mean: {', '.join(close)}?" if close else ""
        fail(f'unknown action {argv[1]!r} in {head}.{hint} List: {PROG} {head} | search: {PROG} search "{head} {argv[1]}"')
    for op in OPS:
        if op["op_id"] and norm(op["op_id"]) == norm(head):
            return op, argv[1:]
    same = [op for op in OPS if op["action"] == head]
    if len(same) == 1:
        return same[0], argv[1:]
    suggestions = search_lines(" ".join(a for a in argv[:3] if not a.startswith("-")), 5)
    fail(f"unknown command {head!r}." + ("\nClosest matches:\n" + "\n".join(suggestions) if suggestions else f" Run `{PROG}` to list groups."))


def path_slots(op: Op) -> list[Param]:
    order = re.findall(r"\{([^}]+)\}", op["path"])
    return [p for name in order for p in op["params"] if p["name"] == name and p["loc"] == "path"]


def parse_args(op: Op, args: list[str]) -> tuple[dict[str, list[str]], dict[str, str]]:
    """Split args into operation values (by flag) and global options. Leading bare values fill path params."""
    by_flag = {p["flag"]: p for p in op["params"]}
    values: dict[str, list[str]] = {}
    options: dict[str, str] = {}
    slots = path_slots(op)
    i = 0
    while i < len(args) and not args[i].startswith("--"):
        if i >= len(slots):
            names = " ".join(f"<{p['flag']}>" for p in slots) or "none"
            fail(f"unexpected argument {args[i]!r}: bare values fill path params ({names}); everything else is --flag value. See: {command(op)} --help")
        values[slots[i]["flag"]] = [args[i]]
        i += 1
    while i < len(args):
        arg = args[i]
        if not arg.startswith("--"):
            fail(f"unexpected argument {arg!r}: pass values as --flag value. See: {command(op)} --help")
        name, eq, value = arg[2:].partition("=")
        param = by_flag.get(name)
        switch = (param is not None and param["kind"] == "bool") or (param is None and name in SWITCHES)
        if not eq:
            if switch and (i + 1 == len(args) or args[i + 1].startswith("--")):
                value = "true"
            elif i + 1 < len(args):
                i += 1
                value = args[i]
            else:
                fail(f"--{name} needs a value")
        if param is not None:
            values.setdefault(name, []).append(value)
        elif name in OPTIONS:
            options[name] = value
        else:
            close = difflib.get_close_matches(name, [*by_flag, *OPTIONS], n=3, cutoff=0.6)
            hint = f" Did you mean {', '.join('--' + c for c in close)}?" if close else ""
            fail(f"unknown flag --{name} for {command(op)}.{hint} See: {command(op)} --help")
        i += 1
    return values, options


def read_arg(text: str) -> str:
    if text == "-":
        piped: str = sys.stdin.read()
        return piped
    if text.startswith("@"):
        return Path(text[1:]).read_text(encoding="utf-8")
    return text


def scalar(p: Param, kind: str, text: str) -> JSON:
    try:
        if kind == "int":
            value: JSON = int(text)
        elif kind == "num":
            value = float(text)
        elif kind == "bool":
            if text.lower() not in ("true", "false", "1", "0", "yes", "no"):
                raise ValueError(text)
            value = text.lower() in ("true", "1", "yes")
        elif kind == "json":
            value = parse_json(read_arg(text))
        else:
            value = text
    except ValueError:
        fail(f"--{p['flag']}: expected {kind}, got {text!r}")
    if "enum" in p and str(value) not in {str(x) for x in p["enum"]}:
        fail(f"--{p['flag']} must be one of: {', '.join(str(x) for x in p['enum'])}")
    return value


def coerce(p: Param, raw: list[str]) -> JSON:
    if p["kind"] == "array":
        items: list[JSON] = []
        for text in raw:
            if text.startswith("["):
                loaded = parse_json(text)
                items += loaded if isinstance(loaded, list) else [loaded]
            else:
                items += [scalar(p, p.get("items", "str"), x.strip()) for x in text.split(",")]
        return items
    if len(raw) > 1:
        fail(f"--{p['flag']} given more than once")
    return raw[0] if p["kind"] == "file" else scalar(p, p["kind"], raw[0])


# ---------- requests ----------


@dataclass
class Request:
    method: str
    url: str
    query: list[tuple[str, str]] = field(default_factory=list)
    headers: dict[str, str] = field(default_factory=dict)
    json_body: JSON = None
    form: dict[str, str] | None = None
    files: dict[str, str] | None = None
    content: bytes | None = None
    basic: tuple[str, str] | None = None
    secrets: list[str] = field(default_factory=list)

    def redact(self, text: str) -> str:
        """Text with every credential value, raw or URL-encoded, replaced by ***."""
        for secret in self.secrets:
            for form in (secret, urllib.parse.quote(secret, safe=""), urllib.parse.quote_plus(secret)):
                text = text.replace(form, "***")
        return text

    def shown(self) -> dict[str, object]:
        """The request as --dry-run prints it: credentials masked."""
        named = ("authorization", "cookie", "token", "key", "secret", "password")
        headers = {k: "***" if any(n in k.lower() for n in named) else self.redact(v) for k, v in self.headers.items()}
        query = [(k, "***" if any(n in k.lower() for n in named) else self.redact(v)) for k, v in self.query]
        body = {"json": self.json_body, "form": self.form, "files": self.files, "content": f"<{len(self.content)} bytes>" if self.content else None}
        return {"method": self.method, "url": self.url, "query": query or None, "headers": headers} | {k: v for k, v in body.items() if v is not None}


def missing_required(op: Op, values: dict[str, list[str]], body: JSON) -> None:
    given = body if isinstance(body, dict) else {}
    missing = [p for p in op["params"] if p.get("required") and p["flag"] not in values and not (p["loc"] in ("body", "form") and p["name"] in given)]
    if missing:
        lines = [f"missing required: {' '.join('--' + p['flag'] for p in missing)}"]
        lines += [f"  --{p['flag']} {type_label(p)}  {p.get('desc', '')}".rstrip() for p in missing]
        fail("\n".join([*lines, f"e.g. {example(op)}"]))


def build_request(op: Op, values: dict[str, list[str]], options: dict[str, str], conf: Settings) -> Request:
    body: JSON = None
    if "input" in options and not op.get("raw_body"):
        try:
            body = parse_json(read_arg(options["input"]))
        except ValueError as e:
            fail(f"--input is not valid JSON: {e}")
    missing_required(op, values, body)
    req = Request(op["method"], "", headers={"User-Agent": f"{PROG}-cli", "Accept": op.get("accept", "application/json")})
    path, fields, files = op["path"], dict[str, JSON](), dict[str, str]()
    for p in op["params"]:
        if p["flag"] in values and p["loc"] != "ws":
            path = place(req, p, coerce(p, values[p["flag"]]), path, fields, files)
    req.url = conf.base_url + path
    authorize(req, INDEX["apis"][op["api"]]["auth"], conf.token)
    if op.get("raw_body") and "input" in options:
        src = options["input"]
        req.content = Path(src[1:]).read_bytes() if src.startswith("@") else read_arg(src).encode()
        req.headers["Content-Type"] = op.get("body_type", "application/octet-stream")
    elif "body_type" in op:
        merged = {**(body if isinstance(body, dict) else {}), **fields}
        if isinstance(body, list):
            req.json_body = body
        elif "form" in op.get("body_type", ""):
            req.form = {k: v if isinstance(v, str) else dumps(v) for k, v in merged.items()}
            req.files = files or None
        elif merged or op.get("body_required"):
            req.json_body = merged
    return req


def place(req: Request, p: Param, value: JSON, path: str, fields: dict[str, JSON], files: dict[str, str]) -> str:
    """Put one parameter value where the operation expects it; returns the path with it filled."""
    if p["loc"] == "path":
        if re.search(r"[?#\x00-\x1f]", str(value)):
            fail(f"--{p['flag']} value {value!r} contains ?, # or a control character; pass query parameters as their own flags")
        return path.replace("{" + p["name"] + "}", urllib.parse.quote(str(value), safe="/" if "path" in p["name"].lower() else ""))
    if p["loc"] == "query":
        items = value if isinstance(value, list) else [value]
        texts = [str(x).lower() if isinstance(x, bool) else str(x) for x in items]
        req.query += [(p["name"], p["sep"].join(texts))] if "sep" in p else [(p["name"], t) for t in texts]
    elif p["loc"] == "header":
        req.headers[p["name"]] = str(value)
    elif p["kind"] == "file" and p["loc"] == "form":
        files[p["name"]] = str(value)
    else:
        fields[p["name"]] = value
    return path


def authorize(req: Request, auth: Auth, token: str | None) -> None:
    if not token or auth["type"] == "none":
        return
    req.secrets += [token, token.partition(":")[2]] if auth["type"] == "basic" else [token]
    if auth["type"] == "bearer":
        req.headers["Authorization"] = f"Bearer {token}"
    elif auth["type"] == "header":
        req.headers[auth.get("name", "Authorization")] = auth.get("template", "{token}").replace("{token}", token)
    elif auth["type"] == "query":
        req.query.append((auth.get("name", "api_key"), token))
    elif auth["type"] == "basic":
        user, _, password = token.partition(":")
        req.basic = (user, password)


def send_http(client: httpx.Client, req: Request, url: str, query: list[tuple[str, str]] | None) -> httpx.Response:
    with contextlib.ExitStack() as stack:
        files = {name: stack.enter_context(Path(path).open("rb")) for name, path in (req.files or {}).items()}
        params = tuple(query) if query else None
        return client.request(req.method, url, params=params, headers=req.headers, json=req.json_body, data=req.form, files=files or None, content=req.content, auth=req.basic)


def execute(op: Op, values: dict[str, list[str]], options: dict[str, str]) -> int:
    conf = settings(INDEX["apis"][op["api"]])
    if op["method"] not in ("GET", "HEAD", "WS") and conf.read_only:
        fail(f"{INDEX['apis'][op['api']]['env']}_READ_ONLY is set: {op['method']} commands are disabled")
    if op["method"] == "WS":
        return stream(op, values, options, conf)
    req = build_request(op, values, options, conf)
    if truthy(options.get("dry-run")):
        out(dumps(req.shown()))
        return 0
    if op["method"] == "DELETE" and not truthy(options.get("yes")):
        fail(f"{command(op)} deletes data: add --yes to confirm (or --dry-run to preview)")
    if not req.url.startswith(("http://", "https://")):
        fail(f"no server URL for {req.url!r}: set {INDEX['apis'][op['api']].get('base_env', INDEX['apis'][op['api']]['env'] + '_BASE_URL')}")
    import httpx

    try:
        with httpx.Client(timeout=30, follow_redirects=True) as client:
            return fetch(client, op, req, options)
    except httpx.HTTPError as e:
        err(f"error: {type(e).__name__} calling {op['method']} {req.url}: {req.redact(str(e))}")
        return 1


def fetch(client: httpx.Client, op: Op, req: Request, options: dict[str, str]) -> int:
    resp = send_http(client, req, req.url, req.query)
    pages: list[JSON] = []
    while resp.status_code < 400:
        nxt = next_url(resp)
        if not truthy(options.get("paginate")) or not nxt or len(pages) + 1 >= MAX_PAGES:
            break
        pages.append(parse_json(resp.content))
        resp = send_http(client, req, urllib.parse.urljoin(str(resp.url), nxt), None)
    if resp.status_code >= 400:
        return http_error(op, resp, req)
    if pages:
        pages.append(parse_json(resp.content))
        merged: list[JSON] = []
        for page in pages:
            if isinstance(page, list):
                merged += page
            elif isinstance(page, dict):
                merged += next((v for v in page.values() if isinstance(v, list)), [page])
        if next_url(resp):
            err(f"[stopped after {MAX_PAGES} pages; more remain]")
        emit(merged, options)
        return 0
    nxt = next_url(resp)
    if nxt:
        page = dict(urllib.parse.parse_qsl(urllib.parse.urlparse(nxt).query)).get("page")
        total = resp.headers.get("x-total-count")
        err(f"[more results{f' (total {total})' if total else ''}: add {f'--page {page} or ' if page else ''}--paginate]")
    return respond(resp, options)


def next_url(resp: httpx.Response) -> str | None:
    """The next page from a Link header, or a next URL in the JSON body."""
    link = resp.links.get("next", {}).get("url")
    if link:
        return link
    if "json" not in resp.headers.get("content-type", ""):
        return None
    try:
        data = parse_json(resp.content)
    except ValueError:
        return None
    for path in (["next"], ["pagination", "next"], ["links", "next"], ["_links", "next", "href"], ["meta", "next"]):
        value = lookup(data, path)
        if isinstance(value, str) and value.startswith(("http://", "https://", "/")):
            return value
    return None


def http_error(op: Op, resp: httpx.Response, req: Request) -> int:
    text = resp.text.strip()
    try:
        detail = dumps(parse_json(text))
    except ValueError:
        detail = text
    detail = detail[:600] + ("…" if len(detail) > 600 else "")
    msg = req.redact(f"HTTP {resp.status_code} {resp.reason_phrase} from {op['method']} {resp.request.url}: {detail}")
    env = INDEX["apis"][op["api"]]["env"]
    if resp.status_code in (401, 403) and not os.environ.get(f"{env}_TOKEN"):
        msg += f"\nhint: set {env}_TOKEN"
    elif resp.status_code in (401, 403):
        msg += f"\nhint: {env}_TOKEN was sent and refused: check its value and scopes. If the API wants a prefix (e.g. 'token …'), rebuild the CLI with api-cli --auth"
    elif resp.status_code == 404:
        msg += "\nhint: check the path values (" + ", ".join(f"--{p['flag']}" for p in op["params"] if p["loc"] == "path") + ")"
    elif resp.status_code in (400, 422):
        msg += f"\nhint: {command(op)} --help lists the accepted flags"
    err(msg)
    return 1


def respond(resp: httpx.Response, options: dict[str, str]) -> int:
    ctype = resp.headers.get("content-type", "")
    if not resp.content:
        out(dumps({"status": resp.status_code, "ok": True}))
    elif "output" in options:
        Path(options["output"]).write_bytes(resp.content)
        out(dumps({"saved": options["output"], "bytes": len(resp.content), "content_type": ctype}))
    elif "json" in ctype:
        emit(parse_json(resp.content), options)
    elif ctype.startswith("text/") or "xml" in ctype:
        out(resp.text)
    else:
        err(f"binary response ({ctype}, {len(resp.content)} bytes): save it with --output FILE")
    return 0


# ---------- websockets ----------


def stream(op: Op, values: dict[str, list[str]], options: dict[str, str], conf: Settings) -> int:
    """Connect, send any --send messages, print matching messages as JSON lines until --count or --timeout."""
    from websockets.exceptions import ConnectionClosed, InvalidHandshake
    from websockets.sync.client import connect

    ws_params = {p["name"]: p for p in op["params"] if p["loc"] == "ws"}
    count_text = values.get("count", [str(ws_params["count"].get("default", 10))])[0]
    timeout_text = values.get("timeout", [str(ws_params["timeout"].get("default", 10))])[0]
    try:
        count, timeout = int(count_text), float(timeout_text)
    except ValueError as e:
        fail(f"--count needs a whole number and --timeout a number of seconds: {e}")
    sends = [read_arg(x) for x in values.get("send", [])]
    matches = [m.partition("=") for m in values.get("match", [])]
    req = build_request(op, {k: v for k, v in values.items() if k not in ws_params}, options, conf)
    url = req.url + ("?" + urllib.parse.urlencode(req.query) if req.query else "")
    shown_url = req.redact(url)
    headers = {k: v for k, v in req.headers.items() if k != "Accept"}
    if truthy(options.get("dry-run")):
        out(dumps({"url": shown_url, "headers": req.shown()["headers"], "send": sends, "count": count, "timeout": timeout}))
        return 0
    paths = [p.strip().split(".") for p in options.get("fields", "").split(",") if p.strip()]
    got, reason = 0, "count"
    deadline = time.monotonic() + timeout
    try:
        with connect(url, additional_headers=headers, open_timeout=min(10.0, timeout)) as ws:
            for message in sends:
                ws.send(message)
            while got < count:
                left = deadline - time.monotonic()
                if left <= 0:
                    reason = "timeout"
                    break
                try:
                    raw = ws.recv(timeout=left)
                except TimeoutError:
                    reason = "timeout"
                    break
                try:
                    msg = parse_json(raw)
                except ValueError:
                    msg = raw if isinstance(raw, str) else f"<{len(raw)} bytes>"
                if not all(str(lookup(msg, key.split("."))) == want for key, _, want in matches):
                    continue
                out(dumps(concise(project(msg, paths) if paths else msg)))
                sys.stdout.flush()
                got += 1
    except ConnectionClosed as e:
        reason = f"closed by server ({e.rcvd.code if e.rcvd else 'no close frame'})"
    except BrokenPipeError:
        raise
    except (OSError, InvalidHandshake) as e:
        err(f"error: cannot connect to {shown_url}: {req.redact(str(e))}")
        return 1
    err(f"[{got} message(s); stopped: {reason}]")
    return 0


# ---------- output ----------


def lookup(value: JSON, path: list[str]) -> JSON:
    for key in path:
        value = child(value, key)
    return value


def child(value: JSON, key: str) -> JSON:
    if isinstance(value, dict):
        return value.get(key)
    if isinstance(value, list) and key.isdigit() and int(key) < len(value):
        return value[int(key)]
    return None


def concise(value: JSON) -> JSON:
    """Drop null and empty values: they cost tokens and carry no answer."""
    if isinstance(value, dict):
        kept = {k: concise(v) for k, v in value.items()}
        return {k: v for k, v in kept.items() if v not in (None, "", [], {})}
    if isinstance(value, list):
        return [concise(v) for v in value]
    return value


def project(value: JSON, paths: list[list[str]]) -> JSON:
    """Keep only the dotted paths; lists are mapped through."""
    if isinstance(value, list):
        return [project(v, paths) for v in value]
    if not isinstance(value, dict):
        return value
    heads: dict[str, list[list[str]]] = {}
    for p in paths:
        heads.setdefault(p[0], []).append(p[1:])
    return {k: value[k] if any(not r for r in rests) else project(value[k], [r for r in rests if r]) for k, rests in heads.items() if k in value}


def leaf_paths(value: JSON, prefix: str = "", depth: int = 0) -> list[str]:
    if isinstance(value, list):
        return leaf_paths(value[0], prefix, depth) if value else []
    if not isinstance(value, dict) or depth > 2:
        return [prefix.rstrip(".")] if prefix else []
    found: list[str] = []
    for k, v in value.items():
        found += leaf_paths(v, f"{prefix}{k}.", depth + 1) if isinstance(v, (dict, list)) and v else [prefix + k]
    return found


def biggest_list(value: JSON, path: tuple[str, ...] = ()) -> tuple[tuple[str, ...], list[JSON]] | None:
    """The largest list in the top two levels: the payload of an envelope response."""
    if isinstance(value, list):
        return path, value
    if not isinstance(value, dict) or len(path) >= 2:
        return None
    found = [x for k, v in value.items() if (x := biggest_list(v, (*path, k))) is not None]
    return max(found, key=lambda x: len(dumps(x[1]))) if found else None


def emit(data: JSON, options: dict[str, str]) -> None:
    raw = truthy(options.get("raw"))
    if "fields" in options:
        full = data
        data = project(data, [p.strip().split(".") for p in options["fields"].split(",") if p.strip()])
        if concise(data) in ({}, [], None) or (isinstance(data, list) and all(x == {} for x in data)):
            err(f"[--fields matched nothing. Available: {','.join(leaf_paths(full)[:30])}]")
    if not raw:
        data = concise(data)
    tty = sys.stdout.isatty()
    text = dumps(data, pretty=tty)
    if raw or "fields" in options or tty or len(text) <= GUARD_CHARS:
        out(text)
        return
    truncate(data, text)


def truncate(data: JSON, text: str) -> None:
    """Print a valid, shortened JSON document and say how to get the rest."""
    fd, saved = tempfile.mkstemp(prefix=f"{PROG}-", suffix=".json")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
    found = biggest_list(data)
    if found is None or not found[1]:
        keys = ",".join(data) if isinstance(data, dict) else ""
        out(dumps({"truncated": True, "bytes": len(text), "top_level_fields": keys}))
        err(f"[output is {len(text) // 1024} KB; full JSON: {saved}. Narrow with --fields, or --raw for everything]")
        return
    where, items = found
    kept: list[JSON] = []
    size = len(text) - len(dumps(items))
    for item in items:
        size += len(dumps(item)) + 1
        if size > GUARD_CHARS and kept:
            break
        kept.append(item)
    shown: JSON = kept
    if where:
        shown = parse_json(dumps(data))
        node: JSON = shown
        for key in where[:-1]:
            node = node.get(key) if isinstance(node, dict) else None
        if isinstance(node, dict):
            node[where[-1]] = kept
    out(dumps(shown))
    prefix = ".".join(where) + "." if where else ""
    paths = [prefix + p for p in leaf_paths(items[0])][:30]
    best = sorted((p for p in paths if p.rsplit(".", 1)[-1] in PREFERRED), key=lambda p: PREFERRED.index(p.rsplit(".", 1)[-1]))
    err(
        f"[truncated {'.'.join(where) or 'the list'}: showing {len(kept)} of {len(items)} items. Full JSON ({len(text) // 1024} KB): {saved}\n"
        f" narrow with --fields, e.g. --fields {','.join((best or paths)[:3])}\n available: {','.join(paths)}\n --raw prints everything]"
    )


def main(argv: list[str] | None = None) -> int:
    args = sys.argv[1:] if argv is None else argv
    try:
        if not args or args[0] in ("-h", "--help", "help"):
            out(overview())
            return 0
        api_search = len(args) > 1 and any(op["group"] == "search" and op["action"] == args[1] for op in OPS)
        if args[0] == "search" and not api_search:
            return search_command(args[1:])
        found = resolve(args)
        if isinstance(found, str):
            out(found)
            return 0
        op, rest = found
        if "-h" in rest or "--help" in rest:
            out(op_help(op))
            return 0
        values, options = parse_args(op, rest)
        return execute(op, values, options)
    except UsageError as e:
        err(f"error: {e}")
        return 2
    except KeyboardInterrupt:
        return 130
    except BrokenPipeError:
        # The reader (e.g. `| head`) has gone; point stdout at devnull so exit doesn't raise again.
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
